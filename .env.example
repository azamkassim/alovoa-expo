# Working product identity. Change these before a public release if you choose a final brand.
EXPO_PUBLIC_APP_NAME=OpenCircle
EXPO_PUBLIC_APP_SLUG=open-circle
EXPO_PUBLIC_APP_SCHEME=opencircle
EXPO_PUBLIC_APP_VERSION=0.1.0

# Android/iOS application identifiers.
ANDROID_PACKAGE=com.azamkassim.opencircle
IOS_BUNDLE_IDENTIFIER=com.azamkassim.opencircle

# REQUIRED for a usable independent build: your Alovoa-compatible backend.
# Android emulator -> http://10.0.2.2:8080
# Physical phone on Wi-Fi -> use your backend machine's LAN IP, e.g. http://192.168.1.50:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Local development only. Keep false for public builds and use HTTPS.
EXPO_PUBLIC_ALLOW_CLEARTEXT=false

# Default opens Jitsi rooms in a secure browser session. Point to your own deployment for production control.
EXPO_PUBLIC_VIDEO_BASE_URL=https://meet.jit.si

# Optional native app-links domain, e.g. app.example.com
# APP_LINK_DOMAIN=app.example.com

# Optional Expo Application Services values.
# EAS_PROJECT_ID=
# EXPO_OWNER=
